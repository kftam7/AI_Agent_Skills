# Copy to .env and fill in your keys (never commit .env)
# Do not wrap values in quotes.

# Default working pair for this course (pick the ones you have):
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional — curriculum also supports Grok/xAI when you have a key:
# XAI_API_KEY=your_xai_api_key_here

# Default provider for working_agent.py (overridden by agent_config.json / --provider)
# AGENT_PROVIDER=deepseek

# MiniMax region: key and host MUST match
#   global = key from https://platform.minimax.io     → api.minimax.io  (default)
#   cn     = key from https://platform.minimaxi.com   → api.minimaxi.com
MINIMAX_REGION=global
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional model overrides
# DEEPSEEK_MODEL=deepseek-chat
# MINIMAX_MODEL=MiniMax-M3.1-Flash
# MINIMAX_REASONING_EFFORT=low
# XAI_MODEL=grok-4.7
